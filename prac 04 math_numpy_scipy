#math library

import math 
a=2.3
b=5
c=10
print("The ceil of 2.3 is:", end=" ")
print(math.ceil(a))

print("The floor of 2.3 is:", end=" ")
print(math.floor(a))

print("The factorial of 5 is:", end=" ")
print(math.factorial(b))

print("The absolute of -10 is:", end=" ")
print(math.fabs(a))

print("The gcd of 5 and 15 is:", end=" ")
print(math.gcd(b,c))

print("The value of log 2 with base 3 is:", end=" ")
print(math.log(2,3))

print("The value of log 2 of 16 is:", end=" ")
print(math.log2(16))

print("The value of log 10 of 10000 is:", end=" ")
print(math.log10(10000))


#numpy library
import numpy as np

arr1 = np.array([1, 2, 3])
print("Array with Rank1:\n", arr1)

arr2 = np.array([[1, 2, 3],[4, 5, 6]])
print("Array with Rank2:\n", arr2)

arr3=np.array((1, 3, 2))
print("Array created using passed tuple:\n", arr3)

arr = np.array([[-1, 2, 0, 4], [4, -0.5, 6, 0], [2.6, 0, 7, 8], [3, -7, 4, 2.0]])
print("Initial Array:\n", arr)

scliced_arr=arr[ :2, : :2]
print("Array with first 2 rows and alternate columns (0 and 2):\n", scliced_arr)

index_arr=arr[[1, 1, 0, 3], [3, 2, 1, 0]]
print("Element at indices (1,3),(1,2),(0,1),(3,0):\n", index_arr)
